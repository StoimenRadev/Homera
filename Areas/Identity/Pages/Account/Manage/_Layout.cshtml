@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout != null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Areas/Identity/Pages/_Layout.cshtml";
    }
}

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
            <div class="card-header bg-white border-bottom p-4">
                <div class="d-flex align-items-center">
                    <div class="bg-primary-light text-primary rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <span style="font-size: 1.5rem;">🌿</span>
                    </div>
                    <div>
                        <h1 class="h4 fw-bold mb-0"><span class="text-primary">Homera</span> Account Settings</h1>
                        <p class="mb-0 text-muted small">Update your profile and security preferences</p>
                    </div>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="row g-0">
                    <div class="col-md-4 col-lg-3 border-end bg-light">
                        <div class="p-3">
                            <partial name="_ManageNav" />
                        </div>
                    </div>
                    <div class="col-md-8 col-lg-9 p-4 p-md-5">
                        @RenderBody()
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
