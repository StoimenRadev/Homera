@page
@model EmailModel
@{
    ViewData["Title"] = "Email Settings";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<partial name="_StatusMessage" for="StatusMessage" />

<div class="mb-4">
    <h3 class="h5 fw-bold mb-1">Manage Email</h3>
    <p class="text-muted small">Update your primary contact email address.</p>
</div>

<form id="email-form" method="post">
    <div asp-validation-summary="All" class="text-danger small mb-3" role="alert"></div>
    
    <div class="mb-3">
        <label asp-for="Email" class="form-label small fw-bold">Current Email</label>
        <div class="input-group">
            <input asp-for="Email" class="form-control bg-light border-0" disabled placeholder="No email set." />
            <span class="input-group-text bg-light border-0">📧</span>
        </div>
    </div>

    <div class="mb-4">
        <label asp-for="Input.NewEmail" class="form-label small fw-bold">New Email Address</label>
        <input asp-for="Input.NewEmail" class="form-control shadow-sm" autocomplete="email" aria-required="true" placeholder="Enter your new email address" />
        <span asp-validation-for="Input.NewEmail" class="text-danger small"></span>
    </div>

    <div class="d-grid pt-2">
        <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="btn btn-primary btn-lg shadow-sm py-3">Update Email Address</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
