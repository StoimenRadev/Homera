@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Security Settings";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<partial name="_StatusMessage" for="StatusMessage" />

<div class="mb-4">
    <h3 class="h5 fw-bold mb-1">Change Password</h3>
    <p class="text-muted small">Manage your account security and authentication.</p>
</div>

<form id="change-password-form" method="post">
    <div asp-validation-summary="All" class="text-danger small mb-3" role="alert"></div>
    
    <div class="mb-3">
        <label asp-for="Input.OldPassword" class="form-label small fw-bold">Current Password</label>
        <input asp-for="Input.OldPassword" class="form-control shadow-sm" autocomplete="current-password" aria-required="true" placeholder="Enter your current password" />
        <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.NewPassword" class="form-label small fw-bold">New Password</label>
        <input asp-for="Input.NewPassword" class="form-control shadow-sm" autocomplete="new-password" aria-required="true" placeholder="Enter a strong new password" />
        <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
    </div>

    <div class="mb-4">
        <label asp-for="Input.ConfirmPassword" class="form-label small fw-bold">Confirm New Password</label>
        <input asp-for="Input.ConfirmPassword" class="form-control shadow-sm" autocomplete="new-password" aria-required="true" placeholder="Re-type your new password" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
    </div>

    <div class="d-grid pt-2">
        <button id="change-password-button" type="submit" class="btn btn-primary btn-lg shadow-sm py-3">Update Account Password</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
