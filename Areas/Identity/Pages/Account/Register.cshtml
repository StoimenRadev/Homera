@page
@model RegisterModel
@{
    ViewData["Title"] = "Join Homera";
}

<div class="row justify-content-center">
    <div class="col-md-10 col-lg-8 col-xl-6 py-5">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden mt-4">
            <div class="card-header bg-primary text-white p-4 text-center border-0">
                <div class="mb-2" style="font-size: 2.5rem;">🌿</div>
                <h1 class="h3 fw-bold mb-0">Create Your Account</h1>
                <p class="mb-0 opacity-75 small">Start booking professional care for your home</p>
            </div>
            <div class="card-body p-4 p-md-5">
                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-4" role="alert"></div>
                    
                    <div class="mb-4">
                        <label asp-for="Input.Username" class="form-label small fw-bold text-muted">Username</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0">👤</span>
                            <input asp-for="Input.Username" class="form-control bg-light border-0 px-3 py-2" aria-required="true" placeholder="Choose a unique username" />
                        </div>
                        <span asp-validation-for="Input.Username" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Input.FirstName" class="form-label small fw-bold text-muted">First Name</label>
                            <input asp-for="Input.FirstName" class="form-control bg-light border-0 px-3 py-2" aria-required="true" placeholder="John" />
                            <span asp-validation-for="Input.FirstName" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.LastName" class="form-label small fw-bold text-muted">Last Name</label>
                            <input asp-for="Input.LastName" class="form-control bg-light border-0 px-3 py-2" aria-required="true" placeholder="Doe" />
                            <span asp-validation-for="Input.LastName" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.Email" class="form-label small fw-bold text-muted">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0">✉️</span>
                            <input asp-for="Input.Email" class="form-control bg-light border-0 px-3 py-2" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        </div>
                        <span asp-validation-for="Input.Email" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="row g-3 mb-5">
                        <div class="col-md-6">
                            <label asp-for="Input.Password" class="form-label small fw-bold text-muted">Password</label>
                            <input asp-for="Input.Password" class="form-control bg-light border-0 px-3 py-2" autocomplete="new-password" aria-required="true" placeholder="Min. 6 characters" type="password" />
                            <span asp-validation-for="Input.Password" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.ConfirmPassword" class="form-label small fw-bold text-muted">Confirm Password</label>
                            <input asp-for="Input.ConfirmPassword" class="form-control bg-light border-0 px-3 py-2" autocomplete="new-password" aria-required="true" placeholder="Re-enter password" type="password" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <button id="registerSubmit" type="submit" class="w-100 btn btn-primary btn-lg shadow-sm py-3 mb-4 rounded-3 fw-bold">Create Account & Start Exploring</button>
                    
                    <div class="text-center">
                        <p class="small text-muted mb-0">
                            Already have an account? 
                            <a asp-page="./Login" class="text-primary fw-bold text-decoration-none ms-1">Log In Instead</a>
                        </p>
                    </div>
                </form>
            </div>
        </div>
        
        <div class="text-center mt-4">
            <a asp-controller="Home" asp-action="Index" class="text-muted small text-decoration-none">← Back to Homepage</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

