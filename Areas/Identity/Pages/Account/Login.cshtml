@page
@model LoginModel

@{
    ViewData["Title"] = "Welcome Back";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5 col-xl-4 py-5">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden mt-4">
            <div class="card-header bg-primary text-white p-4 text-center border-0">
                <div class="mb-2" style="font-size: 2.5rem;">🌿</div>
                <h1 class="h3 fw-bold mb-0">Welcome Back</h1>
                <p class="mb-0 opacity-75 small">Log in to your Homera account</p>
            </div>
            <div class="card-body p-4 p-md-5">
                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-4" role="alert"></div>
                    
                    <div class="mb-4">
                        <label asp-for="Input.Username" class="form-label small fw-bold text-muted">Username</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0">👤</span>
                            <input asp-for="Input.Username" class="form-control bg-light border-0 px-3 py-2" autocomplete="username" aria-required="true" placeholder="Enter your username" />
                        </div>
                        <span asp-validation-for="Input.Username" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.Password" class="form-label small fw-bold text-muted">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0">🔒</span>
                            <input asp-for="Input.Password" class="form-control bg-light border-0 px-3 py-2" autocomplete="current-password" aria-required="true" placeholder="Enter your password" type="password" />
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input class="form-check-input shadow-none" asp-for="Input.RememberMe" />
                            <label asp-for="Input.RememberMe" class="form-check-label small text-muted">
                                Keep me logged in
                            </label>
                        </div>
                    </div>

                    <button id="login-submit" type="submit" class="w-100 btn btn-primary btn-lg shadow-sm py-3 mb-4 rounded-3 fw-bold">Sign In to Dashboard</button>
                    
                    <div class="text-center">
                        <p class="small text-muted mb-0">
                            New to Homera? 
                            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-primary fw-bold text-decoration-none ms-1">Create an Account</a>
                        </p>
                    </div>
                </form>
            </div>
        </div>
        
        <div class="text-center mt-4">
            <a asp-controller="Home" asp-action="Index" class="text-muted small text-decoration-none">← Back to Homepage</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

