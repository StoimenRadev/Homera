@{
    ViewData["Title"] = "Care for your home, pets, and loved ones";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8 mx-auto text-center">
                @if (User.IsInRole(Homera.Models.Enums.UserRole.Administrator))
                {
                    <h1 class="display-3 mb-4">Administrator Dashboard</h1>
                    <p class="lead text-muted mb-5">Welcome back to the Homera management suite. Oversee system tasks, manage users, and ensure service excellence.</p>
                    <div class="d-flex justify-content-center gap-3">
                        <a asp-controller="Admin" asp-action="Index" class="btn btn-primary px-5 py-3 shadow">Enter Admin Dashboard</a>
                        <a asp-controller="Users" asp-action="Index" class="btn btn-outline-primary px-5 py-3">Manage Users</a>
                    </div>
                }
                else if (User.IsInRole(Homera.Models.Enums.UserRole.Housekeeper))
                {
                    <h1 class="display-3 mb-4">Housekeeper Console</h1>
                    <p class="lead text-muted mb-5">Welcome back. Your professional care makes a difference. Check your upcoming tasks and manage your active schedule.</p>
                    <div class="d-flex justify-content-center gap-3">
                        <a asp-controller="TaskItems" asp-action="Index" class="btn btn-primary px-5 py-3 shadow">View My Schedule</a>
                    </div>
                }
                else
                {
                    <h1 class="display-3 mb-4">Care for your home, pets, and loved ones</h1>
                    <p class="lead text-muted mb-5">Reliable, professional housekeeping services tailored to your family's needs. From plants to parents, we've got you covered.</p>
                    <div class="d-flex justify-content-center gap-3">
                        <a asp-controller="TaskItems" asp-action="Create" class="btn btn-primary px-5 py-3 shadow">Book a Service</a>
                        <a asp-controller="TaskItems" asp-action="Services" class="btn btn-outline-primary px-5 py-3">Explore Services</a>
                    </div>
                }
            </div>
        </div>
    </div>
</section>


@if (!User.IsInRole(Homera.Models.Enums.UserRole.Administrator) && !User.IsInRole(Homera.Models.Enums.UserRole.Housekeeper))
{
    <!-- How It Works -->
    <section class="py-5 bg-white rounded-4 shadow-sm my-5">
        <div class="container py-4">
            <div class="text-center mb-5">
                <h2 class="h1">How It Works</h2>
                <p class="text-muted">Getting your home cared for is as easy as 1-2-3</p>
            </div>
            <div class="row text-center g-5">
                <div class="col-md-4">
                    <div class="mb-4">
                        <span class="badge rounded-circle bg-primary-subtle text-primary p-3 h3 mb-0" style="width: 60px; height: 60px; display: inline-flex; align-items: center; justify-content: center;">1</span>
                    </div>
                    <h4>Choose Service</h4>
                    <p class="text-muted">Select the type of care your home or family needs from our categories.</p>
                </div>
                <div class="col-md-4">
                    <div class="mb-4">
                        <span class="badge rounded-circle bg-primary-subtle text-primary p-3 h3 mb-0" style="width: 60px; height: 60px; display: inline-flex; align-items: center; justify-content: center;">2</span>
                    </div>
                    <h4>Schedule & Book</h4>
                    <p class="text-muted">Pick a date and time that works for you and provide details about the task.</p>
                </div>
                <div class="col-md-4">
                    <div class="mb-4">
                        <span class="badge rounded-circle bg-primary-subtle text-primary p-3 h3 mb-0" style="width: 60px; height: 60px; display: inline-flex; align-items: center; justify-content: center;">3</span>
                    </div>
                    <h4>Enjoy Peace of Mind</h4>
                    <p class="text-muted">Our professional assistants take care of the rest while you focus on what matters.</p>
                </div>
            </div>
        </div>
    </section>
}

