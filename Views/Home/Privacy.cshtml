@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="row justify-content-center">
    <div class="col-lg-10 col-xl-8 mt-4 mt-md-5">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-5">
            <div class="card-header bg-white border-bottom p-4">
                <div class="d-flex align-items-center">
                    <div class="bg-primary-light text-primary rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <span style="font-size: 1.5rem;">🛡️</span>
                    </div>
                    <div>
                        <h1 class="h3 fw-bold mb-0">Privacy Policy</h1>
                        <p class="mb-0 text-muted small">Last updated: April 2026</p>
                    </div>
                </div>
            </div>
            <div class="card-body p-4 p-md-5">
                <section class="mb-5">
                    <h2 class="h5 fw-bold text-dark mb-3">1. Information We Collect</h2>
                    <p class="text-muted mb-4">At Homera, we take your privacy seriously. We collect personal information that you provide to us when you register on the platform, create a task, or communicate with us.</p>
                    <ul class="text-muted">
                        <li><strong>Profile Data:</strong> Names, usernames, and contact details.</li>
                        <li><strong>Service Data:</strong> Location addresses and task descriptions.</li>
                        <li><strong>Usage Data:</strong> How you interact with our services and performance logs.</li>
                    </ul>
                </section>

                <section class="mb-5 border-top pt-4">
                    <h2 class="h5 fw-bold text-dark mb-3">2. How We Use Your Information</h2>
                    <p class="text-muted mb-3">We use the information we collect to provide, maintain, and improve our services, including:</p>
                    <ul class="text-muted">
                        <li>Connecting clients with professional помощници.</li>
                        <li>Ensuring secure access to your account and managed locations.</li>
                        <li>Sending service-related notifications and updates.</li>
                    </ul>
                </section>

                <section class="mb-0 border-top pt-4">
                    <h2 class="h5 fw-bold text-dark mb-3">3. Data Security</h2>
                    <p class="text-muted mb-0">We implement robust technical and organizational measures to protect your personal data against unauthorized access, loss, or alteration. All passwords are encrypted using state-of-the-art hashing algorithms.</p>
                </section>
            </div>
            <div class="card-footer bg-light border-0 py-4 text-center">
                <p class="text-muted small mb-0">If you have any questions about this Privacy Policy, please contact us at <a href="mailto:privacy@homera.bg" class="text-primary fw-bold text-decoration-none">privacy@homera.bg</a></p>
            </div>
        </div>
    </div>
</div>
