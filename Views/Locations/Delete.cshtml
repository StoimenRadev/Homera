@model Homera.Models.Location

@{
    ViewData["Title"] = "Delete Location";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden mt-5">
            <div class="card-header bg-danger text-white p-4 text-center">
                <div class="mb-2" style="font-size: 2.5rem;">⚠️</div>
                <h1 class="h4 fw-bold mb-0">Delete Location?</h1>
            </div>
            <div class="card-body p-4 p-md-5">
                <p class="text-center text-muted mb-4">Are you sure you want to remove <strong>@Model.Name</strong>?
                    This action cannot be undone and may affect pending tasks at this location.</p>

                <div class="bg-light rounded-3 p-3 mb-4">
                    <div class="d-flex align-items-center mb-2">
                        <span class="me-2 text-primary">📍</span>
                        <span class="small fw-bold">Address</span>
                    </div>
                    <p class="mb-0 text-dark ps-4">@Model.Street @Model.HouseNumber, @Model.Neighbourhood, @Model.City
                    </p>
                </div>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger btn-lg py-3">Permanently Delete</button>
                        <a asp-action="Index" class="btn btn-light py-2">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
