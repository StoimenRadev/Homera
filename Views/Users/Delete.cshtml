@model Homera.Models.User

@{
    ViewData["Title"] = "Delete User";
}

<div class="row justify-content-center">
    <div class="col-md-6 mt-4 mt-md-5">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-5">
            <div class="card-header bg-danger text-white p-4 text-center">
                <div class="mb-2" style="font-size: 2.5rem;">⚠️</div>
                <h1 class="h4 fw-bold mb-0">Remove User Account?</h1>
            </div>
            <div class="card-body p-4 p-md-5">
                <p class="text-center text-muted mb-4">Are you sure you want to delete the account for <strong>@Model.FirstName @Model.LastName</strong> (@@@Model.UserName)? This action will revoke all access and potentially orphan associated tasks or locations.</p>
                
                <div class="bg-light rounded-4 p-4 mb-4">
                    <div class="row g-3 text-center">
                        <div class="col-6">
                            <label class="text-muted smaller d-block mb-1">Username</label>
                            <span class="fw-bold">@@@Model.UserName</span>
                        </div>
                        <div class="col-6">
                            <label class="text-muted smaller d-block mb-1">Assigned Role</label>
                            <span class="badge bg-danger rounded-pill px-3">@ViewBag.UserRole</span>
                        </div>
                    </div>
                </div>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger btn-lg py-3 shadow-sm fw-bold">Confirm Deletion</button>
                        <a asp-action="Index" class="btn btn-light py-2 text-muted">Cancel and Back</a>
                    </div>
                </form>
            </div>
            <div class="card-footer bg-light border-0 py-3 text-center">
                <small class="text-muted italic">Caution: This action cannot be reversed.</small>
            </div>
        </div>
    </div>
</div>
