@model IEnumerable<Homera.Models.User>

@{
    ViewData["Title"] = "User Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1">User Management</h1>
        <p class="text-muted small">Manage platform users and roles</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm">+ Add User</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Full Name</th>
                    <th>Username</th>
                    <th>Current Role</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="fw-bold">@item.FirstName @item.LastName</div>
                        </td>
                        <td>
                            <span class="text-muted">@item.UserName</span>
                        </td>
                        <td>
                            @{
                                var userRolesDict = ViewBag.UserRoles as Dictionary<int, string>;
                                var roleStr = userRolesDict != null && userRolesDict.ContainsKey(item.Id) ? userRolesDict[item.Id] : "Client";
                                var roleClass = roleStr.Contains("Administrator") ? "bg-secondary text-white" : 
                                               (roleStr.Contains("Housekeeper") ? "bg-primary text-white" : "bg-light text-dark");
                            }
                            <span class="badge @roleClass rounded-pill px-3">@roleStr</span>
                        </td>
                        <td class="text-end pe-4">
                            <div class="d-flex justify-content-end gap-2">
                                @if (roleStr == "Client")
                                {
                                    <form asp-action="PromoteToHousekeeper" asp-route-id="@item.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-success">Promote</button>
                                    </form>
                                }
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light border" title="Edit">✏️</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light border" title="Details">📄</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Delete">🗑️</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

