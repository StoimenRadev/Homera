@model Homera.Models.User

@{
    ViewData["Title"] = "User Details";
}

<div class="row justify-content-center">
    <div class="col-md-7 mt-4 mt-md-5">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-5">
            <div class="card-header bg-white border-bottom p-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                        <div class="bg-primary-light text-primary rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <span style="font-size: 1.5rem;">🆔</span>
                        </div>
                        <div>
                            <h1 class="h4 fw-bold mb-0">User Profile</h1>
                            <p class="text-muted mb-0 small">Account information for @Model.UserName</p>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm px-3">Edit</a>
                        <a asp-action="Index" class="btn btn-light btn-sm px-3">Back</a>
                    </div>
                </div>
            </div>
            <div class="card-body p-4 p-md-5">
                <div class="row g-4">
                    <div class="col-sm-6">
                        <label class="text-muted smaller d-block mb-1">First Name</label>
                        <p class="fw-bold mb-0 fs-5">@Model.FirstName</p>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted smaller d-block mb-1">Last Name</label>
                        <p class="fw-bold mb-0 fs-5">@Model.LastName</p>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted smaller d-block mb-1">Username</label>
                        <p class="fw-bold mb-0 text-primary">@@@Model.UserName</p>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted smaller d-block mb-1">User Role</label>
                        <span class="badge rounded-pill bg-primary px-3 py-2 fw-bold mt-1">@ViewBag.UserRole</span>
                    </div>
                </div>

                <div class="mt-5 pt-4 border-top">
                    <h2 class="h6 fw-bold text-uppercase tracking-wider text-muted mb-3">Quick Actions</h2>
                    <div class="d-grid gap-2">
                        @if (ViewBag.UserRole == "Client")
                        {
                            <a asp-controller="Locations" asp-action="Index" class="btn btn-light text-start p-3 border rounded-3 position-relative">
                                🏠 Manage @Model.FirstName's Locations
                                <span class="position-absolute end-0 top-50 translate-middle-y me-3">→</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
