@model Homera.Models.User

@{
    ViewData["Title"] = "Edit User";
}

<div class="row justify-content-center">
    <div class="col-md-6 mt-4 mt-md-5">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-5">
            <div class="card-header bg-primary text-white p-4">
                <div class="d-flex align-items-center">
                    <div class="bg-white text-primary rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <span style="font-size: 1.5rem;">👤</span>
                    </div>
                    <div>
                        <h1 class="h4 fw-bold mb-0">Edit User Account</h1>
                        <p class="mb-0 opacity-75 small">Update profile and permissions for @Model.UserName</p>
                    </div>
                </div>
            </div>
            <div class="card-body p-4 p-md-5">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FirstName" class="form-label small fw-bold">First Name</label>
                            <input asp-for="FirstName" class="form-control" placeholder="John" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="LastName" class="form-label small fw-bold">Last Name</label>
                            <input asp-for="LastName" class="form-control" placeholder="Doe" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label small fw-bold">Username</label>
                        <input asp-for="UserName" class="form-control" placeholder="johndoe123" />
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold">Access Permissions / Role</label>
                        <select name="role" class="form-select shadow-sm" asp-items="ViewBag.Roles"></select>
                    </div>

                    <div class="d-grid gap-3 pt-2">
                        <button type="submit" class="btn btn-primary btn-lg shadow-sm py-3">Save Account Updates</button>
                        <a asp-action="Index" class="btn btn-light text-muted">Cancel and Back</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
