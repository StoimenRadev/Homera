@{
    ViewData["Title"] = "Our Expertise";
}

<div class="row align-items-center mb-5">
    <div class="col-lg-8 mx-auto text-center">
        <h1 class="display-4 fw-bold text-dark mb-3">Our Dedicated Services</h1>
        <p class="lead text-muted">Professional, compassionate, and reliable care for everything that makes your life beautiful.</p>
    </div>
</div>

<div class="row g-4 mb-5">
    <!-- Pet Care -->
    <div class="col-md-6 col-xl-3">
        <div class="card h-100 border-0 shadow-sm rounded-4 shadow-hover transition overflow-hidden">
            <div class="card-body p-4 text-center d-flex flex-column">
                <div class="bg-warning-light text-warning rounded-circle p-4 mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 100px; height: 100px; font-size: 3.5rem;">
                    🐾
                </div>
                <h3 class="h4 fw-bold mb-3 text-dark">Pet Care</h3>
                <p class="text-muted small mb-4">Professional walking, feeding, and quality companionship for your furry family members.</p>
                <div class="mt-auto">
                    <a asp-action="Create" class="btn btn-outline-primary w-100 rounded-pill fw-bold">Book Pet Care</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Plant Care -->
    <div class="col-md-6 col-xl-3">
        <div class="card h-100 border-0 shadow-sm rounded-4 shadow-hover transition overflow-hidden">
            <div class="card-body p-4 text-center d-flex flex-column">
                <div class="bg-primary-light text-primary rounded-circle p-4 mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 100px; height: 100px; font-size: 3.5rem;">
                    🌿
                </div>
                <h3 class="h4 fw-bold mb-3 text-dark">Plant Care</h3>
                <p class="text-muted small mb-4">Expert watering, pruning, and seasonal nurturing for your indoor and outdoor greenery.</p>
                <div class="mt-auto">
                    <a asp-action="Create" class="btn btn-outline-primary w-100 rounded-pill fw-bold">Book Plant Care</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Elderly Care -->
    <div class="col-md-6 col-xl-3">
        <div class="card h-100 border-0 shadow-sm rounded-4 shadow-hover transition overflow-hidden">
            <div class="card-body p-4 text-center d-flex flex-column">
                <div class="bg-info-light text-info rounded-circle p-4 mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 100px; height: 100px; font-size: 3.5rem;">
                    👵
                </div>
                <h3 class="h4 fw-bold mb-3 text-dark">Elderly Care</h3>
                <p class="text-muted small mb-4">Compassionate assistance with daily activities and meaningful social interaction.</p>
                <div class="mt-auto">
                    <a asp-action="Create" class="btn btn-outline-primary w-100 rounded-pill fw-bold">Book Assistance</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Cleaning -->
    <div class="col-md-6 col-xl-3">
        <div class="card h-100 border-0 shadow-sm rounded-4 shadow-hover transition overflow-hidden">
            <div class="card-body p-4 text-center d-flex flex-column">
                <div class="bg-success-light text-success rounded-circle p-4 mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 100px; height: 100px; font-size: 3.5rem;">
                    ✨
                </div>
                <h3 class="h4 fw-bold mb-3 text-dark">Home Cleaning</h3>
                <p class="text-muted small mb-4">Deep cleaning and organization services to keep your living space perfectly maintained.</p>
                <div class="mt-auto">
                    <a asp-action="Create" class="btn btn-outline-primary w-100 rounded-pill fw-bold">Book Cleaning</a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="bg-white rounded-4 shadow-sm p-5 text-center my-5">
    <h3 class="h2 fw-bold mb-4">Need a Custom Service?</h3>
    <p class="text-muted mx-auto mb-4" style="max-width: 600px;">If you have unique requirements not listed above, our team of professional assistants is ready to accommodate your specific housekeeping needs.</p>
    <a asp-controller="Home" asp-action="Privacy" class="btn btn-primary btn-lg px-5 rounded-pill shadow-sm">Contact Support</a>
</div>
