@model Homera.Models.TaskItem

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>TaskItem</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <div class="mb-3">
            <label class="form-label d-block">Quick Templates:</label>
            <button type="button" class="btn btn-outline-secondary btn-sm me-2" onclick="fillTemplate('Weekly Cleaning', 'Standard weekly home cleaning including floors and dusting.', 0, 50.00)">🧹 Cleaning</button>
            <button type="button" class="btn btn-outline-secondary btn-sm me-2" onclick="fillTemplate('Water Flowers', 'Water all indoor and outdoor plants.', 1, 20.00)">🌻 Pets & Plants</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="fillTemplate('Elderly Care', 'Assistance with mobility, meals, and companionship for an elderly person.', 3, 100.00)">👵 Elderly Care</button>
        </div>

        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Budget" class="control-label"></label>
                <input asp-for="Budget" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Budget" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Deadline" class="control-label"></label>
                <input asp-for="Deadline" class="form-control" type="datetime-local" />
                <span asp-validation-for="Deadline" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Category" class="control-label"></label>
                <select asp-for="Category" class="form-control" asp-items="Html.GetEnumSelectList<Homera.Models.Enums.TaskCategory>()"></select>
                <span asp-validation-for="Category" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="LocationId" class="control-label"></label>
                <div class="input-group">
                    <select asp-for="LocationId" class ="form-control" asp-items="ViewBag.LocationId">
                        <option value="">-- Select Location --</option>
                    </select>
                    <a asp-controller="Locations" asp-action="Create" class="btn btn-outline-primary" title="Add New Location">+</a>
                </div>
                <span asp-validation-for="LocationId" class="text-danger"></span>
                @if (((SelectList)ViewBag.LocationId).Count() == 0)
                {
                    <small class="text-warning">You haven't added any locations yet. <a asp-controller="Locations" asp-action="Create">Create one now</a> to start adding tasks.</small>
                }
            </div>
            <div class="form-group mb-3">
                <label asp-for="HousekeeperId" class="control-label">Домакин (опция)</label>
                <select asp-for="HousekeeperId" class="form-control" asp-items="ViewBag.HousekeeperId">
                    <option value="">-- Изберете Домакин --</option>
                </select>
                <span asp-validation-for="HousekeeperId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function fillTemplate(name, desc, category, budget) {
            document.querySelector('[name="Name"]').value = name;
            document.querySelector('[name="Description"]').value = desc;
            document.querySelector('[name="Category"]').value = category;
            document.querySelector('[name="Budget"]').value = budget.toFixed(2);
            
            // Set deadline to 2 days from now
            let now = new Date();
            now.setDate(now.getDate() + 2);
            now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
            document.querySelector('[name="Deadline"]').value = now.toISOString().slice(0, 16);
        }
    </script>
}
