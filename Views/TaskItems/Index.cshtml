@model IEnumerable<Homera.Models.TaskItem>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Budget)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Deadline)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Category)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ReviewDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ImagePath)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Client)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Housekeeper)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Location)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Budget)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Deadline)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Category)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ReviewDate)
            </td>
            <td>
                @if (!string.IsNullOrEmpty(item.ImagePath))
                {
                    <a href="javascript:void(0)" onclick="showImageModal('@item.ImagePath')">Преглед</a>
                }
                else
                {
                    <span>-</span>
                }
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Client!.FirstName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Housekeeper!.FirstName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Location!.DisplayName)
            </td>
            <td>
                @if (item.Status == Homera.Models.Enums.TaskItemStatus.Pending || User.IsInRole(UserRole.Administrator))
                {
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> @:|
                    <a asp-action="Delete" asp-route-id="@item.Id">Cancel</a> @:|
                }
                @if (item.Status == Homera.Models.Enums.TaskItemStatus.Assigned && User.IsInRole(Homera.Models.Enums.UserRole.Housekeeper))
                {
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Submit Work</a> @:|
                }
                <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                @if (item.Status == Homera.Models.Enums.TaskItemStatus.InReview && (User.IsInRole(UserRole.Client) || User.IsInRole(UserRole.Administrator)))
                {
                    @:|
                    <form asp-action="Complete" asp-route-id="@item.Id" method="post" style="display:inline;">
                        <input type="submit" value="Complete" class="btn btn-sm btn-success" />
                    </form>
                }
            </td>
        </tr>
}
    </tbody>
</table>

<!-- Modal for Image Preview -->
<div class="modal fade" id="imagePreviewModal" tabindex="-1" aria-labelledby="imagePreviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="imagePreviewModalLabel">Преглед на доказателство</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <img id="modalImagePath" src="" class="img-fluid rounded shadow-sm" alt="Proof Image" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showImageModal(imagePath) {
            document.getElementById('modalImagePath').src = imagePath;
            var myModal = new bootstrap.Modal(document.getElementById('imagePreviewModal'));
            myModal.show();
        }
    </script>
}
