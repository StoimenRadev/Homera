@model Homera.Models.TaskItem

@{
    ViewData["Title"] = "Delete Task";
}

<div class="row justify-content-center">
    <div class="col-md-6 mt-4 mt-md-5">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-5">
            <div class="card-header bg-danger text-white p-4 text-center">
                <div class="mb-2" style="font-size: 2.5rem;">🗑️</div>
                <h1 class="h4 fw-bold mb-0">Cancel this Task?</h1>
            </div>
            <div class="card-body p-4 p-md-5">
                <p class="text-center text-muted mb-4">Are you sure you want to remove this task request? This action will permanently delete all associated data for <strong>@Model.Name</strong>.</p>
                
                <div class="bg-light rounded-4 p-4 mb-4">
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="text-muted smaller d-block mb-1">Category</label>
                            <span class="fw-bold">@Model.Category</span>
                        </div>
                        <div class="col-6 text-end">
                            <label class="text-muted smaller d-block mb-1">Budget</label>
                            <span class="fw-bold text-primary">@Model.Budget лв.</span>
                        </div>
                        <div class="col-12 border-top pt-2">
                            <label class="text-muted smaller d-block mb-1">Location</label>
                            <span class="small fw-bold">@Model.Location?.DisplayName</span>
                        </div>
                    </div>
                </div>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger btn-lg py-3 shadow-sm fw-bold">Confirm Deletion</button>
                        <a asp-action="Index" class="btn btn-light py-2 text-muted">Keep Task & Go Back</a>
                    </div>
                </form>
            </div>
            <div class="card-footer bg-light border-0 py-3 text-center">
                <small class="text-muted italic">Warning: This action cannot be undone.</small>
            </div>
        </div>
    </div>
</div>
