@model Homera.Models.TaskItem

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>TaskItem</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Budget)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Budget)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Deadline)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Deadline)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Category)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Category)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ReviewDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ReviewDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ImagePath)
        </dt>
        <dd class = "col-sm-10">
            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <img src="@Model.ImagePath" alt="Proof Image" style="max-width:100%; height:auto; display:block;" />
            }
            else
            {
                <span>No proof uploaded</span>
            }
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Client)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Client!.FirstName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Housekeeper)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Housekeeper!.FirstName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Location)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Location!.DisplayName)
        </dd>
    </dl>
</div>
<div>
    @if (Model?.Status == Homera.Models.Enums.TaskItemStatus.Pending)
    {
        <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> @:|
    }
    @if (Model?.Status == Homera.Models.Enums.TaskItemStatus.InReview && (User.IsInRole(UserRole.Client) || User.IsInRole(UserRole.Administrator)))
    {
        <form asp-action="Complete" asp-route-id="@Model?.Id" method="post" style="display:inline;">
            <input type="submit" value="Complete" class="btn btn-sm btn-success" />
        </form> @:|
    }
    @if ((Model?.Status == Homera.Models.Enums.TaskItemStatus.Assigned || Model?.Status == Homera.Models.Enums.TaskItemStatus.InReview) 
          && User.IsInRole(Homera.Models.Enums.UserRole.Housekeeper))
    {
        <div class="card mt-4 border-info shadow-sm">
            <div class="card-body">
                <h5 class="card-title">@(Model.Status == Homera.Models.Enums.TaskItemStatus.InReview ? "Update Your Work" : "Submit Your Work")</h5>
                <p class="card-text text-muted small">You can upload a proof image to submit or update your work.</p>
                <form asp-action="SubmitWork" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                    <div class="form-group mb-3">
                        <label class="form-label">@(Model.Status == Homera.Models.Enums.TaskItemStatus.InReview ? "Change Proof Image" : "Upload Proof Image")</label>
                        <input type="file" name="fileProof" class="form-control shadow-sm" required />
                    </div>
                    <button type="submit" class="btn btn-info w-100">@(Model.Status == Homera.Models.Enums.TaskItemStatus.InReview ? "Update Submission" : "Submit for Review")</button>
                </form>
            </div>
        </div>
        <br />
    }
    <a asp-action="Index">Back to List</a>
</div>
