@model Homera.Models.TaskItem

@{
    ViewData["Title"] = "Edit Task";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-5 mt-4">
            <div class="card-header bg-primary text-white p-4">
                <div class="d-flex align-items-center">
                    <div class="bg-white text-primary rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <span style="font-size: 1.5rem;">✏️</span>
                    </div>
                    <div>
                        <h1 class="h3 fw-bold mb-0">Edit Task</h1>
                        <p class="mb-0 opacity-75 small">Update the details of your service request</p>
                    </div>
                </div>
            </div>
            <div class="card-body p-4 p-md-5">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label small fw-bold">Task Name</label>
                        <input asp-for="Name" class="form-control form-control-lg" placeholder="What needs to be done?" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label small fw-bold">Detailed Description</label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Add specific instructions..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Budget" class="form-label small fw-bold">Estimated Budget (лв.)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">лв.</span>
                                <input asp-for="Budget" class="form-control border-start-0" type="number" step="0.01" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Budget" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Deadline" class="form-label small fw-bold">Required By</label>
                            <input asp-for="Deadline" class="form-control" type="datetime-local" />
                            <span asp-validation-for="Deadline" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Category" class="form-label small fw-bold">Category</label>
                            <select asp-for="Category" class="form-select" asp-items="Html.GetEnumSelectList<Homera.Models.Enums.TaskCategory>()"></select>
                            <span asp-validation-for="Category" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="LocationId" class="form-label small fw-bold">Service Location</label>
                            <select asp-for="LocationId" class="form-select" asp-items="ViewBag.LocationId"></select>
                            <span asp-validation-for="LocationId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="HousekeeperId" class="form-label small fw-bold">Assigned Помощник (Optional)</label>
                        <select asp-for="HousekeeperId" class="form-select" asp-items="ViewBag.HousekeeperId">
                            <option value="">-- Изберете Помощник --</option>
                        </select>
                        <span asp-validation-for="HousekeeperId" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ReviewDate" class="form-label small fw-bold">Review Date (Optional)</label>
                            <input asp-for="ReviewDate" class="form-control" type="datetime-local" />
                            <span asp-validation-for="ReviewDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ImagePath" class="form-label small fw-bold">Image URL (Optional)</label>
                            <input asp-for="ImagePath" class="form-control" placeholder="URL to photo" />
                            <span asp-validation-for="ImagePath" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-grid gap-3 pt-3">
                        <button type="submit" class="btn btn-primary btn-lg shadow-sm py-3">Update Task Details</button>
                        <a asp-action="Index" class="btn btn-light text-muted">Cancel and Back</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
