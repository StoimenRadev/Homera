@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6 mt-4 mt-md-5">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-5">
            <div class="card-header bg-danger text-white p-4 text-center border-0">
                <div class="mb-2" style="font-size: 2.5rem;">⚠️</div>
                <h1 class="h3 fw-bold mb-0">Something went wrong</h1>
                <p class="mb-0 opacity-75 small">An error occurred while processing your request.</p>
            </div>
            <div class="card-body p-4 p-md-5">
                <p class="text-center text-muted mb-4">We apologize for the inconvenience. Our technical team has been notified of the issue.</p>
                
                @if (Model.ShowRequestId)
                {
                    <div class="bg-light rounded-3 p-3 text-center mb-4">
                        <span class="text-muted small d-block mb-1 text-uppercase tracking-wider">Reference ID</span>
                        <code class="fw-bold text-dark">@Model.RequestId</code>
                    </div>
                }

                <div class="d-grid gap-2">
                    <a href="/" class="btn btn-primary shadow-sm py-3">Return to Homepage</a>
                    <button onclick="history.back()" class="btn btn-light text-muted">Go Back</button>
                </div>

                <div class="mt-5 pt-4 border-top">
                    <h2 class="h6 fw-bold text-dark mb-3">Diagnostic Information</h2>
                    <div class="alert alert-warning border-0 small mb-0">
                        <strong>Development Mode:</strong> Swapping to <strong>Development</strong> environment will display more detailed information about the error that occurred. Ensure this is only enabled for local debugging.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
