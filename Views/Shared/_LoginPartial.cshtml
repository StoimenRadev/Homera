@using Microsoft.AspNetCore.Identity
@using Homera.Models
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

<ul class="navbar-nav align-items-lg-center">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item me-lg-3">
        <a class="nav-link d-flex align-items-center" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage Profile">
            <div class="bg-primary-light text-primary rounded-circle p-1 me-2 shadow-sm" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; font-size: 0.8rem;">👤</div>
            <span class="fw-bold small">@UserManager.GetUserName(User)</span>
        </a>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="btn btn-outline-danger btn-sm px-3 rounded-pill fw-bold" style="font-size: 0.75rem;">Sign Out</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link small fw-bold px-3 py-2" asp-area="Identity" asp-page="/Account/Register">Join Homera</a>
    </li>
    <li class="nav-item">
        <a class="nav-link btn btn-primary ms-lg-2 px-4 shadow-sm rounded-pill fw-bold text-white py-2" asp-area="Identity" asp-page="/Account/Login">Sign In</a>
    </li>
}
</ul>

